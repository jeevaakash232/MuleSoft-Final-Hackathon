#%RAML 1.0
title: IoT Sensor Data Ingestion API
version: v1
baseUri: http://localhost:8081/api
mediaType: application/json

types:
  Reading:
    type: object
    properties:
      metricName:
        type: string
        required: true
      value:
        type: number
        required: true
      unit:
        type: string
        required: true
      timestamp:
        type: datetime
        required: true

  TelemetryRequest:
    type: object
    properties:
      deviceId:
        type: string
        required: false
      readings:
        type: Reading[]
        required: true

/telemetry:
  post:
    description: Receive telemetry readings from a device
    headers:
      x-api-key:
        description: Device API key for authentication
        type: string
        required: true
    body:
      application/json:
        type: TelemetryRequest
        example:
          {
            "deviceId": "DEV001",
            "readings": [
              {
                "metricName": "TEMPERATURE",
                "value": 30,
                "unit": "CELSIUS",
                "timestamp": "2026-10-09T09:00:00Z"
              }
            ]
          }
    responses:
      202:
        description: Telemetry accepted for processing
        body:
          application/json:
            example:
              {
                "message": "Telemetry accepted for processing",
                "deviceId": "DEV001",
                "siteId": "SITE-CHN-01"
              }
      400:
        description: Invalid telemetry request or missing required fields
        body:
          application/json:
            example:
              { "message": "Bad request: deviceId and x-api-key header are required" }
      401:
        description: Unauthorized - invalid or missing API key
        body:
          application/json:
            example:
              { "message": "Unauthorized" }
      403:
        description: Forbidden - device is inactive
        body:
          application/json:
            example:
              { "message": "Forbidden: device is inactive" }
      500:
        description: Internal server error
        body:
          application/json:
            example:
              { "message": "Internal server error: database unavailable" }
