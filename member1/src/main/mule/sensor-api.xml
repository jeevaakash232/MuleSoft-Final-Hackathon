<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd">

    <!-- ===== Threshold configuration loaded from YAML ===== -->
    <configuration-properties doc:name="Metric Thresholds Config" file="metric-thresholds.yaml" />

    <!-- ===== APIkit config ===== -->
    <apikit:config name="sensor-api-config" api="sensor-api.raml"
                   outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />

    <!-- ===== MySQL DB config ===== -->
    <db:config name="MySQL_Config" doc:name="Database Config">
        <db:my-sql-connection
            host="hackathon-jeevaakash444-2d28.d.aivencloud.com"
            port="22529"
            user="avnadmin"
            password="AVNS_8XbJ46bjH_y69FcbH-S"
            database="iot" />
    </db:config>

    <!-- ===== Main API flow ===== -->
    <http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config" doc:id="40642efe-e049-4489-874e-defa07d3b5db" >
		<http:listener-connection host="0.0.0.0" port="8081" />
	</http:listener-config>
	<db:config name="Database_Config" doc:name="Database Config" doc:id="e836753c-c850-4e59-b51b-1ea1d54997d5" >
		<db:my-sql-connection host="hackathon-jeevaakash444-2d28.d.aivencloud.com" port="22529" user="avnadmin" password="AVNS_8XbJ46bjH_y69FcbH-S" database="iot" />
	</db:config>
	<flow name="sensor-api-main">
        <http:listener config-ref="HTTP_Listener_config" path="/api/*">
            <http:response statusCode="#[vars.httpStatus default (vars.http default 200)]">
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default (vars.http default 500)]">
                <http:body><![CDATA[#[payload]]]></http:body>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="sensor-api-config" />
        <error-handler>
			<on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="404 Not Found">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED">
                <ee:transform doc:name="405 Method Not Allowed">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Method not allowed"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">405</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_ACCEPTABLE">
                <ee:transform doc:name="406 Not Acceptable">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not acceptable"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">406</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:UNSUPPORTED_MEDIA_TYPE">
                <ee:transform doc:name="415 Unsupported Media Type">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Unsupported media type"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">415</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
            <on-error-propagate type="APIKIT:NOT_IMPLEMENTED">
                <ee:transform doc:name="501 Not Implemented">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Not Implemented"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">501</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
			<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="d4ff0066-90d1-422b-8548-79e7970db2f0" type="APIKIT:BAD_REQUEST">
				<ee:transform doc:name="400 Bad Request">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
var description = error.description default ""
---
if (description contains "/deviceId expected type: String, found: Null")
{
    success: false,
    message: "Invalid Device ID",
    errorType: "PAYLOAD_ERROR",
    errorDescription: "Missing or empty required field: deviceId"
}
else
{
    success: false,
    message: "Bad request",
    errorType: "APIKIT:BAD_REQUEST",
    errorDescription: description
}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus"><![CDATA[400]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>
			</on-error-continue>
                    </error-handler>
    </flow>

    <!-- ===== API Console flow ===== -->
    <flow name="sensor-api-console">
        <http:listener config-ref="HTTP_Listener_config" path="/console/*">
            <http:response statusCode="#[vars.http default 200]">
            </http:response>
            <http:error-response statusCode="#[vars.http default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="sensor-api-config" />
        <error-handler>
            <on-error-propagate type="APIKIT:NOT_FOUND">
                <ee:transform doc:name="404 Not Found">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{message: "Resource not found"}]]></ee:set-payload>
                    </ee:message>
                    <ee:variables>
                        <ee:set-variable variableName="httpStatus">404</ee:set-variable>
                    </ee:variables>
                </ee:transform>
            </on-error-propagate>
        </error-handler>
    </flow>

    <!-- ===== POST /telemetry — Validation + Device Authentication Flow ===== -->
    <flow name="post:\telemetry:application\json:sensor-api-config">

        <!-- STEP 1: Save original payload and extract x-api-key BEFORE DB call overwrites payload -->
        <set-variable value="#[attributes.headers['x-api-key'] default null]" doc:name="Set apiKey" doc:id="f90ec2d3-41b5-415e-b8b6-611e95067475" variableName="apiKey"/>
		<set-variable value="#[payload]" doc:name="Set originalPayload" doc:id="9e348333-3547-4ca8-b4c4-2b05e17e849e" variableName="originalPayload"/>
		<choice doc:name="Check x-api-key header">
            <when expression="#[vars.apiKey == null or vars.apiKey == '']">
				<raise-error doc:name="Raise error" doc:id="8b2d4f10-27bf-41fa-b1cb-6c72ba1a77cc" type="APP:VALIDATION_ERROR" description="Not Found"/>
            </when>
			<otherwise>
                <logger level="DEBUG" doc:name="API Key Present" message="api key received successfully" />
            </otherwise>
        </choice>

        <!-- STEP 3: Validate deviceId is present and non-blank -->
        <choice doc:name="Check deviceId">
            <when expression="#[vars.originalPayload.deviceId == null or (vars.originalPayload.deviceId as String) == '']">
                <raise-error type="APP:PAYLOAD_ERROR" description="Missing or empty required field: deviceId" />
            </when>
			<otherwise>
                <logger level="DEBUG" doc:name="DeviceId Present" message="device id received successfully" />
            </otherwise>
        </choice>

        <!-- STEP 4: Validate readings field is present -->

        <!-- STEP 5: Validate readings array is not empty -->

        <!-- STEP 6: Validate each reading has all required fields -->

        <!-- STEP 7: DB Select — authenticate using SHA2 hash comparison in MySQL -->
        <db:select doc:name="Authenticate Device" config-ref="MySQL_Config">
            <db:sql><![CDATA[SELECT device_id, site_id, device_status
FROM device_registry
WHERE device_id = :deviceId
  AND api_key_hash = SHA2(:apiKey, 256)]]></db:sql>
            <db:input-parameters><![CDATA[#[{
    deviceId: vars.originalPayload.deviceId,
    apiKey: vars.apiKey
}]]]></db:input-parameters>
        </db:select>

        <!-- STEP 8: Store auth result — null if device not found -->
        <set-variable doc:name="Store Auth Result" variableName="authResult"
            value="#[if (sizeOf(payload) > 0) payload[0] else null]" />

        <!-- STEP 9: Check authentication result -->
        <choice doc:name="Authentication Check">
            <when expression="#[vars.authResult == null]">
                <logger level="WARN" doc:name="Log Auth Failure"
                        message="#['Authentication failed for deviceId: ' ++ (vars.originalPayload.deviceId default 'unknown')]" />
                <set-variable doc:name="Set httpStatus 401" variableName="httpStatus" value="401" />
                <set-payload doc:name="401 Unauthorized" mimeType="application/json"
                    value='#[output application/json --- { "success": false, "message": "Unauthorized", "errorType": "AUTH:INVALID_CREDENTIALS", "errorDescription": "Invalid device ID or API key" }]' />
            </when>
            <otherwise>
                <!-- STEP 10: Check device status -->
                <choice doc:name="Device Status Check">
                    <when expression="#[vars.authResult.device_status == 'INACTIVE']">
                        <logger level="WARN" doc:name="Log Inactive Device"
                                message="#['Device is INACTIVE: ' ++ vars.authResult.device_id]" />
                        <set-variable doc:name="Set httpStatus 403" variableName="httpStatus" value="403" />
                        <set-payload doc:name="403 Forbidden" mimeType="application/json"
                            value='#[output application/json --- { "success": false, "message": "Forbidden: device is inactive", "errorType": "AUTH:DEVICE_INACTIVE", "errorDescription": "Device is not active" }]' />
                    </when>
                    <otherwise>
                        <logger level="INFO" doc:name="Log Auth Success"
                                message="Authentication successful" />

                        <!-- For Each: iterate readings and seed sensor_current_value with PENDING
                             ONLY for readings whose timestamp falls inside the configured window.
                             Out-of-window readings are skipped here — they will be rejected by
                             timestamp-subflow in process-readings-flow and must not create a DB row.
                             The downstream process-readings-flow upserts again with the actual
                             breachStatus once threshold evaluation completes. -->
                        <foreach doc:name="For Each reading - seed sensor_current_value"
                                 doc:id="2357c1c5-02c4-4fbb-94d8-a4b3ac8bc802"
                                 collection="#[vars.originalPayload.readings]">

                            <db:insert doc:name="DB Insert sensor_current_value - seed current value"
                                       doc:id="d62cf084-8ab8-43c0-843f-3d52f9be62ae"
                                       config-ref="MySQL_Config">
                                <db:sql><![CDATA[INSERT INTO sensor_current_value
    (device_id, metric_name, metric_value, unit, reading_timestamp, breach_status, updated_at)
VALUES
    (:deviceId, :metricName, :metricValue, :unit, :readingTimestamp, 'PENDING', CURRENT_TIMESTAMP)
ON DUPLICATE KEY UPDATE
    metric_value      = IF(VALUES(reading_timestamp) > reading_timestamp, VALUES(metric_value),      metric_value),
    unit              = IF(VALUES(reading_timestamp) > reading_timestamp, VALUES(unit),              unit),
    breach_status     = IF(VALUES(reading_timestamp) > reading_timestamp, 'PENDING',                 breach_status),
    updated_at        = IF(VALUES(reading_timestamp) > reading_timestamp, CURRENT_TIMESTAMP,         updated_at),
    reading_timestamp = IF(VALUES(reading_timestamp) > reading_timestamp, VALUES(reading_timestamp), reading_timestamp)]]></db:sql>
                                <db:input-parameters><![CDATA[#[{
    deviceId:         vars.originalPayload.deviceId,
    metricName:       payload.metricName,
    metricValue:      payload.value,
    unit:             payload.unit,
    readingTimestamp: (((payload.timestamp as DateTime {format: "yyyy-MM-dd'T'HH:mm:ssXXX"}) >> "UTC") as String {format: "yyyy-MM-dd HH:mm:ss"})
}]]]></db:input-parameters>
                            </db:insert>

                        </foreach>

                        <!-- Restore originalPayload after the foreach because each db:insert
                             overwrites payload with an affectedRows result map. -->
                        <set-variable doc:name="Restore originalPayload after foreach"
                            variableName="originalPayload"
                            value="#[vars.originalPayload]" />

                        <flow-ref doc:name="Flow Reference" doc:id="e6f08849-3dcc-47e9-94c1-22cb3d93b358" name="test-process-readings-flow"/>
                    </otherwise>
                </choice>
            </otherwise>
        </choice>

        <!-- Flow-level error handler -->
        <error-handler>
            <on-error-propagate type="DB:CONNECTIVITY" doc:name="DB Connectivity Error">
                <logger level="ERROR" doc:name="Log DB Error"
                        message="#['Database connectivity failure: ' ++ error.description]" />
                <set-variable doc:name="Set httpStatus 500" variableName="httpStatus" value="500" />
                <set-payload doc:name="500 DB Error" mimeType="application/json"
                    value='#[output application/json --- { "success": false, "message": "Internal server error: database unavailable", "errorType": "DB:CONNECTIVITY", "errorDescription": "The service is temporarily unavailable. Please try again later." }]' />
            </on-error-propagate>
            <on-error-propagate type="DB:BAD_SQL_SYNTAX" doc:name="DB SQL Error">
                <logger level="ERROR" doc:name="Log SQL Error"
                        message="#['SQL error: ' ++ error.description]" />
                <set-variable doc:name="Set httpStatus 500" variableName="httpStatus" value="500" />
                <set-payload doc:name="500 SQL Error" mimeType="application/json"
                    value='#[output application/json --- { "success": false, "message": "Internal server error", "errorType": "DB:BAD_SQL_SYNTAX", "errorDescription": "A database query error occurred." }]' />
            </on-error-propagate>
			<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="8d5815be-31fc-4ce5-a8b8-a5242eedfdd1" type="APP:VALIDATION_ERROR">
				<logger level="INFO" doc:name="api error handler" doc:id="39bf7415-aef4-4990-b518-69b4dc58322a" message="#['API error: ' ++ error.description]"/>
				<set-variable doc:name="Set httpStatus 400" variableName="httpStatus" value="400" />
				<set-payload doc:name="Validation Error Response" mimeType="application/json"
					value='#[output application/json --- { "success": false, "message": "api not found", "errorType": error.errorType.identifier, "errorDescription": error.description }]' />
			</on-error-continue>
			<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="2e8fbba3-3bfa-48a0-ac54-9df46a744976" type="APP:PAYLOAD_ERROR">
				<logger level="INFO" doc:name="original payload error" doc:id="b11ed16f-3425-4e3b-8907-832d4480bd56" message="#['PAYLOAD error: ' ++ error.description]"/>
				<set-variable doc:name="Set httpStatus 400" variableName="httpStatus" value="400" />
				<set-payload doc:name="Payload Error Response" mimeType="application/json"
					value='#[output application/json --- { "success": false, "message": "Invalid Device ID", "errorType": error.errorType.identifier, "errorDescription": error.description }]' />
			</on-error-continue>
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="35e23d7c-25ac-44d9-bc3e-5ceb5d6fb3a8" type="ANY">
				<logger level="INFO" doc:name="Any Error" doc:id="eb90bb6d-bdec-47f0-aa3e-83d21cd0c96c" message="#[error.description]"/>
				<set-payload doc:name="Internal Server Error Response" mimeType="application/json"
					value='#[output application/json --- { "success": false, "message": "Internal Server Error", "errorType": error.errorType.identifier, "errorDescription": error.description }]' />
			</on-error-propagate>
        </error-handler>

    </flow>

</mule>
