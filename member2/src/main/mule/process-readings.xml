<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:validation="http://www.mulesoft.org/schema/mule/validation"
      xmlns:vm="http://www.mulesoft.org/schema/mule/vm"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd 
http://www.mulesoft.org/schema/mule/validation http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/vm http://www.mulesoft.org/schema/mule/vm/current/mule-vm.xsd
        http://www.mulesoft.org/schema/mule/core        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http        http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/validation  http://www.mulesoft.org/schema/mule/validation/current/mule-validation.xsd
        http://www.mulesoft.org/schema/mule/vm          http://www.mulesoft.org/schema/mule/vm/current/mule-vm.xsd
        http://www.mulesoft.org/schema/mule/db          http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <vm:config name="Telemetry_VM_Config" doc:name="Telemetry VM Config">
        <vm:queues>
            <vm:queue queueName="telemetry-queue" queueType="PERSISTENT" />
        </vm:queues>
    </vm:config>

    <http:listener-config name="Test_HTTP_Listener_config" doc:name="Test HTTP Listener config">
        <http:listener-connection host="0.0.0.0" port="8082" />
    </http:listener-config>

    <!-- TEST ENTRY FLOW -->
    <flow name="test-process-readings-flow" doc:name="Test Process Readings Flow">

        <http:listener doc:name="Test Listener POST /test/readings"
            config-ref="Test_HTTP_Listener_config" path="/test/readings">
            <http:response statusCode="#[vars.httpStatus default 200]" />
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
            </http:error-response>
        </http:listener>

        <!-- DB Select: fetch current readings from sensor_current_value -->
        <db:select doc:name="DB Select device and readings" config-ref="MySQL_Config">
            <db:sql><![CDATA[SELECT
    scv.device_id       AS deviceId,
    dr.site_id          AS siteId,
    scv.metric_name     AS metricName,
    scv.metric_value    AS value,
    scv.unit            AS unit,
    scv.reading_timestamp AS timestamp
FROM sensor_current_value scv
JOIN device_registry dr ON scv.device_id = dr.device_id
WHERE scv.device_id = :deviceId]]></db:sql>
            <db:input-parameters><![CDATA[#[{ deviceId: (payload as Object).deviceId }]]]></db:input-parameters>
        </db:select>

        <!-- Set originalPayload from DB result -->
        <set-variable doc:name="Set originalPayload from DB" variableName="originalPayload"
            value='#[{
                "deviceId": payload[0].deviceId,
                "siteId":   payload[0].siteId,
                "readings": payload map {
                    "metricName": $.metricName,
                    "value":      $.value,
                    "unit":       $.unit,
                    "timestamp":  $.timestamp as String default "1970-01-01T00:00:00Z"
                }
            }]' />

        <flow-ref doc:name="process-readings-flow" name="process-readings-flow" />

        <error-handler>
            <on-error-continue type="ANY" doc:name="Test error handler">
                <set-variable doc:name="Set httpStatus 400" variableName="httpStatus" value="#[400]" />
                <set-payload doc:name="Build error response"
                    value='#[output application/json --- { "status": "ERROR", "message": error.description }]'
                    mimeType="application/json" />
            </on-error-continue>
        </error-handler>

    </flow>

    <!-- MAIN FLOW -->
    <flow name="process-readings-flow" doc:name="Process Readings Flow">

        <set-variable doc:name="Set readings from body" variableName="readings" value="#[vars.originalPayload.readings]" />

        <choice doc:name="Check readings not empty">
            <when expression="#[vars.readings == null or (sizeOf(vars.readings) == 0)]">
                <raise-error doc:name="Raise empty readings error" type="APP:EMPTY_READINGS" description="Readings array must contain at least one reading" />
            </when>
            <otherwise>
                <logger doc:name="Readings array OK" level="DEBUG" message="#['Readings count: ' ++ (sizeOf(vars.readings) as String)]" />
            </otherwise>
        </choice>

        <set-variable doc:name="Init acceptedCount" variableName="acceptedCount" value="#[0]" />
        <set-variable doc:name="Init rejectedCount" variableName="rejectedCount" value="#[0]" />

        <foreach doc:name="For Each reading" collection="#[vars.readings]">
            <flow-ref doc:name="validate-reading-subflow" name="validate-reading-subflow" />
            <flow-ref doc:name="evaluate-range-subflow"   name="evaluate-range-subflow" />
            <choice doc:name="Accept or Reject reading">
                <when expression="#[vars.rejectReason == '']">
                    <set-variable doc:name="Increment acceptedCount" variableName="acceptedCount" value="#[vars.acceptedCount + 1]" />
                    <flow-ref doc:name="publish-reading-subflow" name="publish-reading-subflow" />
                </when>
                <otherwise>
                    <set-variable doc:name="Increment rejectedCount" variableName="rejectedCount" value="#[vars.rejectedCount + 1]" />
                    <logger doc:name="Log rejected reading" level="WARN"
                        message="#['REJECTED - deviceId: ' ++ (vars.originalPayload.deviceId default 'unknown') ++ ' metricName: ' ++ (payload.metricName default 'unknown') ++ ' reason: ' ++ vars.rejectReason]" />
                </otherwise>
            </choice>
        </foreach>

        <logger doc:name="Log processing summary" level="INFO"
            message="#['Processing complete - accepted: ' ++ (vars.acceptedCount as String) ++ ' rejected: ' ++ (vars.rejectedCount as String)]" />

        <set-variable doc:name="Set httpStatus 202" variableName="httpStatus" value="#[202]" />

        <set-payload doc:name="Build 202 response"
            value='#[output application/json --- { "status": "ACCEPTED", "accepted": vars.acceptedCount, "rejected": vars.rejectedCount, "breachStatus": vars.breachStatus default "NORMAL", "quality": vars.quality default "GOOD", "correlationId": correlationId }]'
            mimeType="application/json" />

    </flow>

    <!-- SUB-FLOW: validate-reading-subflow -->
    <sub-flow name="validate-reading-subflow" doc:name="validate-reading-subflow">

        <set-variable doc:name="Reset rejectReason" variableName="rejectReason" value="#['']" />

        <try doc:name="Validate reading fields">

            <validation:is-not-null doc:name="metricName not null" value="#[payload.metricName]" message="metricName is null" />
            <validation:is-not-null doc:name="value not null"      value="#[payload.value]"      message="value is null" />
            <validation:is-not-null doc:name="timestamp not null"  value="#[payload.timestamp]"  message="timestamp is null" />
            <validation:is-not-blank-string doc:name="metricName not blank" value="#[payload.metricName as String]" message="metricName is blank" />
            <validation:is-not-blank-string doc:name="unit not blank"       value="#[payload.unit as String]"       message="unit is blank" />
            <validation:is-number doc:name="value is number" value="#[payload.value as String]" numberType="DOUBLE" message="value is not a number" />

            <!-- NOTE: timestamp regex removed — DB returns LocalDateTime not ISO-8601 string -->

            <choice doc:name="Check metricName is known">
                <when expression="#[upper(payload.metricName) == 'TEMPERATURE' or upper(payload.metricName) == 'VIBRATION' or upper(payload.metricName) == 'PRESSURE' or upper(payload.metricName) == 'HUMIDITY']">
                    <choice doc:name="Check unit matches metric">
                        <when expression="#[upper(payload.metricName) == 'TEMPERATURE' and payload.unit != 'C']">
                            <set-variable doc:name="Reject: invalid unit TEMPERATURE" variableName="rejectReason" value="#['INVALID_UNIT']" />
                        </when>
                        <when expression="#[upper(payload.metricName) == 'VIBRATION' and payload.unit != 'mm/s']">
                            <set-variable doc:name="Reject: invalid unit VIBRATION" variableName="rejectReason" value="#['INVALID_UNIT']" />
                        </when>
                        <when expression="#[upper(payload.metricName) == 'PRESSURE' and payload.unit != 'bar']">
                            <set-variable doc:name="Reject: invalid unit PRESSURE" variableName="rejectReason" value="#['INVALID_UNIT']" />
                        </when>
                        <otherwise>
                            <logger doc:name="Unit OK" level="DEBUG" message="#['Unit valid for ' ++ payload.metricName ++ ': ' ++ payload.unit]" />
                        </otherwise>
                    </choice>
                </when>
                <otherwise>
                    <set-variable doc:name="Reject: unknown metric" variableName="rejectReason" value="#['UNKNOWN_METRIC']" />
                </otherwise>
            </choice>

            <error-handler>
                <on-error-continue type="ANY" doc:name="Catch validation errors">
                    <set-variable doc:name="Set rejectReason from error" variableName="rejectReason" value="#[error.description]" />
                </on-error-continue>
            </error-handler>

        </try>

    </sub-flow>

    <!-- SUB-FLOW: evaluate-range-subflow -->
    <sub-flow name="evaluate-range-subflow" doc:name="evaluate-range-subflow">

        <choice doc:name="Skip if already rejected">
            <when expression="#[vars.rejectReason == '']">

                <choice doc:name="Set thresholds by metricName">
                    <when expression="#[upper(payload.metricName) == 'TEMPERATURE']">
                        <set-variable doc:name="min TEMPERATURE"  variableName="min"      value="#[-20.0]" />
                        <set-variable doc:name="max TEMPERATURE"  variableName="max"      value="#[120.0]" />
                        <set-variable doc:name="warn TEMPERATURE" variableName="warning"  value="#[75.0]"  />
                        <set-variable doc:name="crit TEMPERATURE" variableName="critical" value="#[95.0]"  />
                    </when>
                    <when expression="#[upper(payload.metricName) == 'VIBRATION']">
                        <set-variable doc:name="min VIBRATION"  variableName="min"      value="#[0.0]"  />
                        <set-variable doc:name="max VIBRATION"  variableName="max"      value="#[50.0]" />
                        <set-variable doc:name="warn VIBRATION" variableName="warning"  value="#[4.0]"  />
                        <set-variable doc:name="crit VIBRATION" variableName="critical" value="#[8.0]"  />
                    </when>
                    <when expression="#[upper(payload.metricName) == 'HUMIDITY']">
    <set-variable doc:name="min HUMIDITY"  variableName="min"      value="#[0.0]"   />
    <set-variable doc:name="max HUMIDITY"  variableName="max"      value="#[100.0]" />
    <set-variable doc:name="warn HUMIDITY" variableName="warning"  value="#[70.0]"  />
    <set-variable doc:name="crit HUMIDITY" variableName="critical" value="#[85.0]"  />
</when>
                    
                    <otherwise>
                        <set-variable doc:name="min PRESSURE"  variableName="min"      value="#[0.0]"  />
                        <set-variable doc:name="max PRESSURE"  variableName="max"      value="#[10.0]" />
                        <set-variable doc:name="warn PRESSURE" variableName="warning"  value="#[6.0]"  />
                        <set-variable doc:name="crit PRESSURE" variableName="critical" value="#[8.5]"  />
                    </otherwise>
                </choice>

                <choice doc:name="Evaluate quality and breach status">
                    <when expression="#[(payload.value as Number) &lt; vars.min or (payload.value as Number) &gt; vars.max]">
                        <set-variable doc:name="quality OUT_OF_RANGE"      variableName="quality"      value="#['OUT_OF_RANGE']" />
                        <set-variable doc:name="breachStatus BREACH"       variableName="breachStatus" value="#['BREACH']"       />
                        <set-variable doc:name="rejectReason OUT_OF_RANGE" variableName="rejectReason" value="#['OUT_OF_RANGE']" />
                    </when>
                    <when expression="#[(payload.value as Number) >= vars.critical]">
                        <set-variable doc:name="quality CRITICAL"      variableName="quality"      value="#['CRITICAL']" />
                        <set-variable doc:name="breachStatus CRITICAL" variableName="breachStatus" value="#['CRITICAL']" />
                    </when>
                    <when expression="#[(payload.value as Number) >= vars.warning]">
                        <set-variable doc:name="quality WARNING"      variableName="quality"      value="#['WARNING']" />
                        <set-variable doc:name="breachStatus WARNING" variableName="breachStatus" value="#['WARNING']" />
                    </when>
                    <otherwise>
                        <set-variable doc:name="quality GOOD"      variableName="quality"      value="#['GOOD']"   />
                        <set-variable doc:name="breachStatus NORMAL" variableName="breachStatus" value="#['NORMAL']" />
                    </otherwise>
                </choice>

                <logger doc:name="Log quality evaluation" level="DEBUG"
                    message="#['Quality eval - metric: ' ++ payload.metricName ++ ' value: ' ++ (payload.value as String) ++ ' quality: ' ++ vars.quality ++ ' breachStatus: ' ++ vars.breachStatus]" />

                <!-- DB Insert: update sensor_current_value with breach status -->
                <db:insert doc:name="DB Insert sensor_readings with breach status" config-ref="MySQL_Config">
                    <db:sql><![CDATA[INSERT INTO sensor_current_value
    (device_id, metric_name, metric_value, unit, reading_timestamp, breach_status, updated_at)
VALUES
    (:deviceId, :metricName, :metricValue, :unit, :readingTimestamp, :breachStatus, CURRENT_TIMESTAMP)
ON DUPLICATE KEY UPDATE
    metric_value      = VALUES(metric_value),
    unit              = VALUES(unit),
    breach_status     = VALUES(breach_status),
    updated_at        = CURRENT_TIMESTAMP,
    reading_timestamp = VALUES(reading_timestamp)]]></db:sql>
                    <db:input-parameters><![CDATA[#[{
    deviceId:         vars.originalPayload.deviceId,
    metricName:       payload.metricName,
    metricValue:      payload.value,
    unit:             payload.unit,
    readingTimestamp: payload.timestamp as String default "1970-01-01 00:00:00",
    breachStatus:     vars.breachStatus
}]]]></db:input-parameters>
                </db:insert>
				<ee:transform doc:name="Transform Message" doc:id="4dc50347-d93f-4152-9526-b7a5e09f4904" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	message:"Message Inserted Successfully"
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>

            </when>
            <otherwise>
                <logger doc:name="Skip range eval" level="DEBUG" message="#['Skipping range eval, already rejected: ' ++ vars.rejectReason]" />
            </otherwise>
        </choice>

    </sub-flow>

    <!-- SUB-FLOW: publish-reading-subflow -->
    <sub-flow name="publish-reading-subflow" doc:name="publish-reading-subflow">

        <try doc:name="Publish to telemetry-queue">

            <vm:publish doc:name="VM Publish to telemetry-queue"
                config-ref="Telemetry_VM_Config" queueName="telemetry-queue">
                <vm:content>#[output application/json ---
                {
                    "deviceId":      vars.originalPayload.deviceId,
                    "metricName":    payload.metricName,
                    "value":         payload.value,
                    "unit":          payload.unit,
                                        "quality":       vars.quality,
                    "breachStatus":  vars.breachStatus,
                    "correlationId": correlationId
                }]</vm:content>
            </vm:publish>

            <logger doc:name="Log queue publish" level="INFO"
                message="#['Queued - quality: ' ++ (vars.quality default 'unknown') ++ ' breachStatus: ' ++ (vars.breachStatus default 'unknown')]" />

            <error-handler>
                <on-error-propagate type="ANY" doc:name="Queue publish failed">
                    <set-variable doc:name="Set httpStatus 500" variableName="httpStatus" value="#[500]" />
                    <set-payload doc:name="Build error response"
                        value='#[output application/json --- { "status": "ERROR", "message": "Queue publish failed", "correlationId": correlationId }]'
                        mimeType="application/json" />
                </on-error-propagate>
            </error-handler>

        </try>

    </sub-flow>

</mule>

